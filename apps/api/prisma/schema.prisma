// Source of truth for the data model. The initial migration adds constraints
// Prisma can't express (CHECKs, a partial index) — see migrations/0001_init.
// Always create new migrations with `prisma migrate dev --create-only` and review
// the SQL so those hand-written constraints are never dropped.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  draft
  published
  cancelled

  @@map("event_status")
}

enum RsvpStatus {
  going
  waitlisted
  cancelled

  @@map("rsvp_status")
}

model User {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String   @unique
  passwordHash     String   @map("password_hash")
  name             String
  /// sha256 of the current refresh token; null = logged out / revoked
  refreshTokenHash String?  @map("refresh_token_hash")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  events Event[]
  rsvps  Rsvp[]

  @@map("users")
}

model Event {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creatorId   String      @map("creator_id") @db.Uuid
  title       String
  description String?
  location    String?
  startsAt    DateTime    @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime    @map("ends_at") @db.Timestamptz(3)
  /// null = unlimited
  capacity    Int?
  /// Denormalised count of `going` RSVPs, maintained in the RSVP transaction
  goingCount  Int         @default(0) @map("going_count")
  status      EventStatus @default(published)
  /// Optimistic-lock version, bumped on every edit
  version     Int         @default(1)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?   @map("deleted_at") @db.Timestamptz(3)

  creator User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  rsvps   Rsvp[]

  @@index([creatorId])
  @@map("events")
}

model Rsvp {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String     @map("event_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  status    RsvpStatus
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Last status change — waitlist is served oldest-first by this column
  updatedAt DateTime   @default(now()) @map("updated_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId], map: "uq_rsvp_event_user")
  @@index([eventId, status, updatedAt])
  @@index([userId, status])
  @@map("rsvps")
}
