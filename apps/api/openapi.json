              }
            }
          },
          "404": {
            "description": "You haven't RSVP'd"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Cancel your RSVP. Your seat goes to the next person on the waitlist.",
        "tags": [
          "rsvps"
        ]
      }
    },
