  "info": {
    "title": "Events API",
    "description": "Events + RSVP API. NestJS · PostgreSQL · JWT.\n\n**Try it:** `POST /api/v1/auth/login` with `demo@events.dev` / `Password123!`,\ncopy `accessToken`, click **Authorize**, then call any endpoint.\n\nErrors always look like `{ statusCode, error, message, path, timestamp, requestId }`.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "NotificationResponse": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "event_reminder",
              "new_attendee",
              "waitlist_promoted",
              "event_updated",
              "event_cancelled"
            ],
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "eventId": {
            "type": "string",
            "nullable": true,
            "description": "Event this notification is about, if any"
          },
          "readAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "type",
          "id",
          "title",
          "body",
          "eventId",
          "readAt",
          "createdAt"
        ]
      },
      "NotificationPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NotificationResponse"
            }
          },
          "unreadCount": {
            "type": "number"
          }
        },
        "required": [
          "items",
          "unreadCount"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "you@example.com",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "description": "At least 8 characters.",
            "example": "Password123!",
            "minLength": 8,
            "maxLength": 128
          },
          "name": {
            "type": "string",
            "example": "Asha Rao",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "email",
          "password",
          "name"
        ]
      },
      "PublicUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name"
        ]
      },
      "AuthTokensResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number",
            "description": "Access-token lifetime in seconds"
          },
          "user": {
            "$ref": "#/components/schemas/PublicUser"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "expiresIn",
          "user"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "demo@events.dev",
            "format": "email"
          },
          "password": {
            "type": "string",
            "example": "Password123!",
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "hostingCount": {
            "type": "number",
            "description": "Events you host (not cancelled)"
          },
          "goingCount": {
            "type": "number",
            "description": "Events you're going to"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "createdAt",
          "hostingCount",
          "goingCount"
        ]
      },
      "MyRsvp": {
        "type": "object",
        "properties": {
          "plusOnes": {
            "type": "number"
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "note": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "plusOnes",
          "phone",
          "note"
        ]
      },
      "HostResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "EventResponse": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "draft",
              "published",
              "cancelled"
            ],
            "type": "string"
          },
          "category": {
            "enum": [
              "tech",
              "music",
              "food",
              "sports",
              "arts",
              "networking",
              "outdoors",
              "other"
            ],
            "type": "string"
          },
          "meetingUrl": {
            "type": "string",
            "nullable": true,
            "description": "The online link. Present only for the host and people going."
          },
          "myRsvp": {
            "nullable": true,
            "description": "Your own RSVP details (plus-ones, phone, note) — present only if you have an active RSVP.",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/MyRsvp"
              }
            ]
          },
          "myRsvpStatus": {
            "nullable": true,
            "description": "The caller's RSVP status — present only when a valid token is sent.",
            "enum": [
              "going",
              "waitlisted",
              "cancelled"
            ],
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "location": {
            "type": "string",
            "nullable": true
          },
          "startsAt": {
            "format": "date-time",
            "type": "string"
          },
          "endsAt": {
            "format": "date-time",
            "type": "string"
          },
          "capacity": {
            "type": "number",
            "nullable": true
          },
          "goingCount": {
            "type": "number"
          },
          "seatsLeft": {
            "type": "number",
            "nullable": true,
            "description": "null when capacity is unlimited"
          },
          "version": {
            "type": "number"
          },
          "reminderMinutes": {
            "type": "number",
            "nullable": true,
            "description": "Minutes before start that attendees get a reminder; null = none"
          },
          "hasMeetingLink": {
            "type": "boolean",
            "description": "True if the event has an online link (the link itself may be hidden from you)"
          },
          "host": {
            "$ref": "#/components/schemas/HostResponse"
          },
          "attendeePreview": {
            "description": "Names of the first few people going (for avatar stacks)",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "status",
          "category",
          "id",
          "title",
          "description",
          "location",
          "startsAt",
          "endsAt",
          "capacity",
          "goingCount",
          "seatsLeft",
          "version",
          "reminderMinutes",
          "hasMeetingLink",
          "host",
          "attendeePreview",
          "createdAt",
          "updatedAt"
        ]
      },
      "MyEventsResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventResponse"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "EventPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventResponse"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "Pass as `cursor` to get the next page; null on the last page."
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "CreateEventDto": {
        "type": "object",
        "properties": {
          "category": {
            "enum": [
              "tech",
              "music",
              "food",
              "sports",
              "arts",
              "networking",
              "outdoors",
              "other"
            ],
            "type": "string",
            "default": "other"
          },
          "status": {
            "description": "`draft` events are visible only to their host.",
            "enum": [
              "draft",
              "published"
            ],
            "type": "string",
            "default": "published"
          },
          "title": {
            "type": "string",
            "example": "Bangalore Backend Meetup",
            "minLength": 3,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "example": "Talks on Postgres internals and NestJS at scale.",
            "maxLength": 5000
          },
          "location": {
            "type": "string",
            "example": "91springboard, Koramangala",
            "maxLength": 200
          },
          "startsAt": {
            "type": "string",
            "description": "ISO 8601, must be in the future.",
            "example": "2026-10-10T12:30:00.000Z"
          },
          "endsAt": {
            "type": "string",
            "description": "ISO 8601, after startsAt.",
            "example": "2026-10-10T15:30:00.000Z"
          },
          "capacity": {
            "type": "number",
            "nullable": true,
            "description": "Max attendees. Omit or null for unlimited.",
            "example": 50,
            "minimum": 1,
            "maximum": 100000
          },
          "meetingUrl": {
            "type": "string",
            "nullable": true,
            "description": "Online meeting link (https). Only people going and the host can see it.",
            "example": "https://meet.google.com/abc-defg-hij",
            "maxLength": 500,
            "format": "uri"
          },
          "reminderMinutes": {
            "type": "number",
            "nullable": true,
            "description": "Remind attendees this many minutes before the start (5 min – 7 days). Omit or null for no reminder.",
            "example": 60,
            "minimum": 5,
            "maximum": 10080
          }
        },
        "required": [
          "title",
          "startsAt",
          "endsAt"
        ]
      },
      "UpdateEventDto": {
        "type": "object",
        "properties": {
          "category": {
            "enum": [
              "tech",
              "music",
              "food",
              "sports",
              "arts",
              "networking",
              "outdoors",
              "other"
            ],
            "type": "string",
            "default": "other"
          },
          "status": {
            "description": "`draft` events are visible only to their host.",
            "enum": [
              "draft",
              "published"
            ],
            "type": "string",
            "default": "published"
          },
          "title": {
            "type": "string",
            "example": "Bangalore Backend Meetup",
            "minLength": 3,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "example": "Talks on Postgres internals and NestJS at scale.",
            "maxLength": 5000
          },
          "location": {
            "type": "string",
            "example": "91springboard, Koramangala",
            "maxLength": 200
          },
          "startsAt": {
            "type": "string",
            "description": "ISO 8601, must be in the future.",
            "example": "2026-10-10T12:30:00.000Z"
          },
          "endsAt": {
            "type": "string",
            "description": "ISO 8601, after startsAt.",
            "example": "2026-10-10T15:30:00.000Z"
          },
          "capacity": {
            "type": "number",
            "nullable": true,
            "description": "Max attendees. Omit or null for unlimited.",
            "example": 50,
            "minimum": 1,
            "maximum": 100000
          },
          "meetingUrl": {
            "type": "string",
            "nullable": true,
            "description": "Online meeting link (https). Only people going and the host can see it.",
            "example": "https://meet.google.com/abc-defg-hij",
            "maxLength": 500,
            "format": "uri"
          },
          "reminderMinutes": {
            "type": "number",
            "nullable": true,
            "description": "Remind attendees this many minutes before the start (5 min – 7 days). Omit or null for no reminder.",
            "example": 60,
            "minimum": 5,
            "maximum": 10080
          },
          "version": {
            "type": "number",
            "description": "Optimistic lock: send the `version` you last read. If someone else edited\nthe event since, you get 409 instead of silently overwriting their change."
          }
        }
      },
      "RsvpDto": {
        "type": "object",
        "properties": {
          "plusOnes": {
            "type": "number",
            "description": "Extra people you're bringing (0–5). Each takes a seat.",
            "example": 1,
            "minimum": 0,
            "maximum": 5
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "description": "Only the host can see it.",
            "example": "+91 98765 43210",
            "pattern": "^\\+?[0-9()\\s-]{6,30}$"
          },
          "note": {
            "type": "string",
            "nullable": true,
            "description": "A note for the host, e.g. dietary needs. Only the host can see it.",
            "example": "Vegetarian",
            "maxLength": 500
          }
        }
      },
      "RsvpResponse": {
        "type": "object",
        "properties": {
          "status": {
            "description": "`going` if you got a seat, `waitlisted` if the event is full.",
            "enum": [
              "going",
              "waitlisted",
              "cancelled"
            ],
            "type": "string"
          },
          "eventId": {
            "type": "string"
          },
          "plusOnes": {
            "type": "number"
          },
          "goingCount": {
            "type": "number",
            "description": "Seats taken (people going, including plus-ones)"
          },
          "seatsLeft": {
            "type": "number",
            "nullable": true,
            "description": "null when capacity is unlimited"
          }
        },
        "required": [
          "status",
          "eventId",
          "plusOnes",
          "goingCount",
          "seatsLeft"
        ]
      },
      "Guest": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "going",
              "waitlisted"
            ],
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "plusOnes": {
            "type": "number"
          },
          "note": {
            "type": "string",
            "nullable": true
          },
          "since": {
            "format": "date-time",
            "type": "string",
            "description": "When they got their seat / joined the waitlist"
          }
        },
        "required": [
          "status",
          "userId",
          "name",
          "email",
          "phone",
          "plusOnes",
          "note",
          "since"
        ]
      },
      "GuestList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Guest"
            }
          },
          "goingRsvps": {
            "type": "number"
          },
          "goingSeats": {
            "type": "number",
            "description": "People going, including plus-ones"
          },
          "waitlisted": {
            "type": "number"
          }
        },
        "required": [
          "items",
          "goingRsvps",
          "goingSeats",
          "waitlisted"
        ]
      },
      "Attendee": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "plusOnes": {
            "type": "number"
          },
          "joinedAt": {
            "format": "date-time",
            "type": "string",
            "description": "When this person got their seat"
          }
        },
        "required": [
          "userId",
          "name",
          "plusOnes",
          "joinedAt"
        ]
      },
      "AttendeePage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Attendee"
            }
          },
          "total": {
            "type": "number",
            "description": "Seats taken (people going, including plus-ones)"
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "items",
          "total",
          "nextCursor"
        ]
      }
    }
  }
}