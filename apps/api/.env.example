# Local dev (docker compose up -d)
DATABASE_URL=postgresql://events:events@localhost:5433/events
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# Comma-separated; empty = allow all (the web app calls from its server, so CORS
# only matters for browsers hitting the API directly, e.g. Swagger)
CORS_ORIGINS=http://localhost:3000
PORT=3001
